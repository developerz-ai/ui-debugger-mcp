#!/usr/bin/env bash
# The CI gate as a single command: typecheck, lint, test — in the order the
# platform's Bun stack profile declares, so the first red leg fails the script
# with a tail that names what was wrong.
#
# The local batch skips the BrowserAdapter integration suite for speed and
# stability under parallel load. CI's separate, isolated step runs it without
# the skip (`.github/workflows/ci.yml`); this batch only mirrors CI's parallel
# `bun test`. Run `bin/setup` first.
set -euo pipefail

cd "$(dirname "$0")/.."

# `&&` not `;`: set -e + `&&` fails on the FIRST red leg, so the captured
# tail names the stage that broke instead of a downstream error masking it.
echo "==> typecheck"
bun run typecheck

echo "==> lint"
bun run lint

echo "==> test"
SKIP_BROWSER_INTEGRATION=1 bun test
