#!/usr/bin/env bash
# Install this repo's dependencies, build the dummy/web e2e fixture, and install
# the pinned Chromium so `bin/check` can run end-to-end on a fresh checkout
# without re-downloading the browser on a re-run.
#
# Idempotent: every step is a no-op when its output is already there.
# Cwd-independent: `cd` to the repo root before running anything, so the
# script works no matter where it is invoked from.
#
# Stages:
#   1. bun runtime         — `bin/require-bun` derives the bun version CI pins
#                             in .github/workflows/ci.yml, selects a runtime at
#                             exactly that version (mise first, the ambient
#                             bun only when its own --version already matches)
#                             and verifies it. The verified bun's directory is
#                             exported onto PATH FIRST, so every later stage
#                             runs on that runtime and not on an arbitrary
#                             ambient bun. Fails loud when the required
#                             version cannot be obtained — setup never runs on
#                             a bun CI would not run on.
#   2. bun install          — root deps, so `bunx tsc` resolves and
#                             node_modules/playwright-core/cli.js exists
#   3. dummy/web fixture    — `bun install --frozen-lockfile && bun run build`
#                             so the e2e suite's static server can find dist/
#   4. Chromium             — repo-pinned playwright-core's CLI downloads the
#                             browser binaries from Playwright's CDN over HTTPS,
#                             with the same bounded retry ci.yml already learned
#                             to need. Skipped when both the pinned chromium AND
#                             its headless shell are already in the Playwright
#                             cache dir, so a re-run with the browser present
#                             does NOT re-download. That dir is RESOLVED, not
#                             assumed — see `_dz_cache_dir` where it happens.
#   5. Library check        — `bun src/cli/chromium-libs.ts "$CACHE_DIR"` proves
#                             every shared library of pinned full Chromium and
#                             its headless shell resolves. Apt / install-deps runs ONLY when
#                             libraries are actually missing AND noninteractive
#                             elevation is available; otherwise the check fails
#                             loud naming every missing library.
#   6. Launch check         — playwright-core actually launches the headless
#                             shell AND full Chromium headlessly, so a missing binary or system lib fails
#                             HERE with the error naming it, not as a mystery
#                             inside `bin/check` / `bun test`. Not retried: a
#                             missing binary or library is not transient.
set -euo pipefail

cd "$(dirname "$0")/.."

# Runtime gate, stage 1: pin the bun version CI runs on. `bin/require-bun`
# DERIVES that version from .github/workflows/ci.yml (the CI configuration is
# the source of truth — mise.toml is a hand-maintained duplicate of it), SELECTS
# a runtime at exactly that version and VERIFIES the runtime's own --version.
# It fails loud with a named `X_BUN_*:` diagnostic when the required runtime
# cannot be obtained, so setup never proceeds on an arbitrary ambient bun.
# It resolves the node it needs to read the CI configuration the same way:
# from PATH, or from mise when node is installed there but not on PATH.
#
# The verified bun's directory goes FIRST on PATH — ahead of every other entry
# that could hold a `bun`, so the root install, the dummy/web install, the
# chromium library check and the launch check all run on the verified runtime.
# Nothing below may put another directory AHEAD of it — a bun installed beside
# mise's node would shadow the verified runtime for every stage that follows.
bun_env=$(bin/require-bun)
BUN_VERSION=$(printf '%s\n' "$bun_env" | sed -n 's/^BUN_VERSION=//p')
BUN_PATH=$(printf '%s\n' "$bun_env" | sed -n 's/^BUN_PATH=//p')
[ -n "$BUN_VERSION" ] || { echo "X_BUN_MISSING: bin/require-bun did not report a bun version" >&2; exit 1; }
[ -n "$BUN_PATH" ] || { echo "X_BUN_MISSING: bin/require-bun did not report a bun path" >&2; exit 1; }
export PATH="$(dirname "$BUN_PATH"):$PATH"
echo "==> bun $BUN_VERSION ($BUN_PATH)"

# node is needed by the stages below (playwright-core's manifest, its CLI).
# A host that manages its runtimes with mise commonly has node INSTALLED but
# NOT on PATH — the mise activation this script replaced put it there, and a
# checkout that has every runtime it needs must not be blocked by that. So an
# installed mise-managed node is resolved here as well and put on PATH: `mise
# where` / `mise which` RESOLVE an already-installed tool, they never fetch
# one. Without a node the setup cannot continue, so it fails loud HERE rather
# than dying later with a bare "node: command not found".
# The node directory goes AFTER the verified bun directory, in BOTH resolution
# branches: a bun installed BESIDE mise's node (a global bun in the node bin
# dir) would otherwise sit ahead of the verified runtime on PATH, and every
# stage below would run on a runtime this script never verified.
if ! command -v node >/dev/null 2>&1; then
  node_bin_dir=""
  node_dir=$(mise where node 2>/dev/null || true)
  if [ -n "$node_dir" ] && [ -x "${node_dir}/bin/node" ]; then
    node_bin_dir="${node_dir}/bin"
  else
    node_bin=$(mise which node 2>/dev/null || true)
    if [ -n "$node_bin" ] && [ -x "$node_bin" ]; then
      node_bin_dir="$(dirname "$node_bin")"
    fi
  fi
  if [ -n "$node_bin_dir" ]; then
    export PATH="$(dirname "$BUN_PATH"):${node_bin_dir}:$PATH"
  fi
  if ! command -v node >/dev/null 2>&1; then
    echo "X_NODE_MISSING: node is not on PATH and mise resolves no installed node — the playwright manifest and CLI need it; install node (e.g. 'mise install node') and re-run" >&2
    exit 1
  fi
fi

echo "==> bun install (root)"
bun install

# dummy/web is a standalone package with its own bun.lock, so the repo-root
# install never reaches it. Both `bun test` (src/dummy-web.e2e.test.ts:141) and
# CI (the "build dummy/web fixture" step in .github/workflows/ci.yml) build the
# fixture's dist/ up front; doing it here too keeps `bin/check` honest when run
# from a fresh clone.
echo "==> dummy/web fixture (install + build)"
(
  cd dummy/web
  # --frozen-lockfile under CI only: locally a plain install is fine and lets
  # `bun install` record any newly added dep. `${CI:+...}` is the form
  # `set -u` exempts, so an unset CI expands to nothing.
  bun install ${CI:+--frozen-lockfile}
  bun run build
)

# Resolve the browser cache dir the way playwright-core itself does, so every
# gate below (the skip-when-cached check, the apt repair reached through the
# library check, and `bun src/cli/chromium-libs.ts "$CACHE_DIR"`) looks where
# `node node_modules/playwright-core/cli.js install chromium` will actually
# have put the binaries. The old one-line
#   CACHE_DIR="${PLAYWRIGHT_BROWSERS_PATH:-$HOME/.cache/ms-playwright}"
# assumed a literal PLAYWRIGHT_BROWSERS_PATH, never knew the '=0' meaning and
# ignored XDG_CACHE_HOME: a checkout whose browsers sit in $XDG_CACHE_HOME, or
# an install run under PLAYWRIGHT_BROWSERS_PATH=0, read as "browser absent" and
# re-downloaded into a dir the launch does not use.
#
# Mirrors the pinned playwright-core's own resolution — its `registryDirectory`
# IIFE (node_modules/playwright-core/lib/coreBundle.js:34465-34478) over
# `defaultRegistryDirectory`/`computeDefaultCacheDirectory` (:34009-34023):
#   PLAYWRIGHT_BROWSERS_PATH=0          -> <playwright-core package root>/.local-browsers
#   PLAYWRIGHT_BROWSERS_PATH=<dir>      -> <dir>
#   (unset)                             -> the platform default below
# plus npm's `npm_config_*` / `npm_package_config_*` env fallbacks (coreBundle.js
# :8835-8840 `getFromENV`) — an install run under one of those is the same
# install; skipping the download here and letting playwright fetch elsewhere is
# how a custom cache used to read as empty. `0` is NOT special to
# XDG_CACHE_HOME: the resolved dir existing is the whole check.
#
# The IIFE's last step — resolving a RELATIVE answer against INIT_CWD/cwd — is
# deliberately not reproduced: setup `cd`s to the repo root, and the download
# and both gates run from that same cwd, so a relative value means the same
# directory to each of them here.
_dz_default_registry_dir() {
  # `computeDefaultCacheDirectory()` + "ms-playwright" (coreBundle.js:34009-34023,
  # in shell): linux returns `XDG_CACHE_HOME || join(homedir(), ".cache")`, darwin
  # `join(homedir(), "Library", "Caches")`. So XDG_CACHE_HOME wins on Linux, HOME
  # wins on macOS, and $HOME/.cache is the LAST resort — the one the old
  # `:-$HOME/.cache/ms-playwright` one-liner treated as THE answer.
  #
  # playwright's third arm (win32 → LOCALAPPDATA) is out of reach in a POSIX
  # script that already needs apt/`$HOME`, so any other kernel takes the linux
  # arm; the same trade the script makes everywhere else.
  local kernel=""
  kernel="$(uname 2>/dev/null || true)"
  if [ "$kernel" != "Darwin" ] && [ -n "${XDG_CACHE_HOME:-}" ]; then
    # Linux: XDG_CACHE_HOME wins outright — homedir() is never consulted, so a
    # checkout whose browsers sit in $XDG_CACHE_HOME is a HIT here, not a
    # re-download into a dir the launch does not use.
    printf '%s\n' "$XDG_CACHE_HOME/ms-playwright"
    return 0
  fi
  local home="${HOME:-}"
  if [ -z "$home" ]; then
    # No HOME to build the default from. Say so and fail rather than answer
    # with a directory nobody will read (os.homedir()'s passwd lookup is out of
    # reach in shell).
    echo "neither HOME nor XDG_CACHE_HOME is set; cannot find the browser cache" >&2
    return 1
  fi
  if [ "$kernel" = "Darwin" ]; then
    printf '%s\n' "$home/Library/Caches/ms-playwright"
    return 0
  fi
  printf '%s\n' "$home/.cache/ms-playwright"
}

_dz_real_path() {
  # The realpath of `$1`, or `$1` itself when the platform's realpath declines
  # (GNU answers a not-yet-existing multi-level path, macOS' does not) or when
  # the platform has neither realpath nor readlink -f. A path that cannot be
  # resolved is answered with itself and the caller treats a missing result as
  # absent — never a reason to abort, and NEVER an empty answer: an empty
  # `dirname` is `.`, which would make the walk below circle forever.
  if command -v realpath >/dev/null 2>&1; then
    local resolved=""
    resolved="$(realpath "$1" 2>/dev/null || true)"
    if [ -n "$resolved" ]; then
      printf '%s\n' "$resolved"
      return 0
    fi
  fi
  if command -v readlink >/dev/null 2>&1; then
    local linked=""
    linked="$(readlink -f "$1" 2>/dev/null || true)"
    if [ -n "$linked" ]; then
      printf '%s\n' "$linked"
      return 0
    fi
  fi
  printf '%s\n' "$1"
}

_dz_package_root() {
  # The playwright-core PACKAGE ROOT — the directory holding its package.json,
  # taken by realpath the way playwright takes it (`packageRoot =
  # join(__dirname, "..")`, coreBundle.js:11891, then `../package.json` read
  # from there). Searched up the ancestors of the cwd FIRST, which
  # `cd "$(dirname "$0")/.."` above made the repo root — the tree whose
  # `node node_modules/playwright-core/cli.js install chromium` downloads, and
  # the copy the launch check below loads. Only when the repo tree has none is
  # the VERIFIED runtime's own directory walked (`node_modules/.bin/bun`
  # resolves to its real binary here, as playwright resolves the realpath of
  # the module it loads) — otherwise a playwright-core that happens to sit
  # above the bun binary (for example a global one under lib/node_modules)
  # would win over the repo's own copy that `PLAYWRIGHT_BROWSERS_PATH=0`
  # actually resolves against.
  local start="" dir="" module=""
  for start in "$PWD" "$(dirname "$(_dz_real_path "$BUN_PATH")")"; do
    dir="$start"
    # Only an absolute start can terminate at `/`; anything else is skipped
    # rather than walked (`dirname` of an empty path is `.`, which circles).
    while [ -n "$dir" ] && [ "${dir#/}" != "$dir" ]; do
      module="$dir/node_modules/playwright-core"
      if [ -f "$module/package.json" ]; then
        module="$(_dz_real_path "$module")"
        if [ -n "$module" ] && [ -f "$module/package.json" ]; then
          printf '%s\n' "$module"
          return 0
        fi
      fi
      if [ "$dir" = "/" ]; then
        break
      fi
      dir="$(dirname "$dir")"
    done
  done
  echo "playwright-core (its package.json) not found from $BUN_PATH or $PWD" >&2
  return 1
}

_dz_browsers_dir() {
  # `getFromENV("PLAYWRIGHT_BROWSERS_PATH")` (coreBundle.js:8835-8840): the
  # plain variable first, then npm's two config spellings, each only consulted
  # when the one above it is empty. Printed explicitly rather than via
  # `${!name:-}` indirect expansion, which macOS' stock bash 3.2 does not
  # support. Prints nothing when no spelling is set — the caller then takes the
  # default arm.
  if [ -n "${PLAYWRIGHT_BROWSERS_PATH:-}" ]; then
    printf '%s\n' "$PLAYWRIGHT_BROWSERS_PATH"
    return 0
  fi
  if [ -n "${npm_config_playwright_browsers_path:-}" ]; then
    printf '%s\n' "$npm_config_playwright_browsers_path"
    return 0
  fi
  if [ -n "${npm_package_config_playwright_browsers_path:-}" ]; then
    printf '%s\n' "$npm_package_config_playwright_browsers_path"
  fi
}

_dz_cache_dir() {
  # The `registryDirectory` IIFE, in shell: '0' -> the package-local cache,
  # any other value -> the value, nothing -> the platform default. The resolved
  # directory EXISTING is the whole skip check downstream, so nothing here
  # requires it to be there — and `0` is not special to XDG_CACHE_HOME.
  local env_defined="" out="" pkg=""
  env_defined="$(_dz_browsers_dir)"
  if [ "$env_defined" = "0" ]; then
    if ! pkg="$(_dz_package_root)" || [ -z "$pkg" ]; then
      echo "X_PACKAGE_ROOT: PLAYWRIGHT_BROWSERS_PATH=0 means <playwright-core>/.local-browsers, and playwright-core cannot be resolved from $BUN_PATH" >&2
      return 1
    fi
    out="$pkg/.local-browsers"
  elif [ -n "$env_defined" ]; then
    out="$env_defined"
  else
    out="$(_dz_default_registry_dir)" || return 1
  fi
  [ -n "$out" ] || return 1
  printf '%s\n' "$out"
}

CACHE_DIR="$(_dz_cache_dir)" || exit 1
[ -n "$CACHE_DIR" ] || { echo "X_CACHE_DIR: could not resolve the Playwright browser cache dir" >&2; exit 1; }

# Parse the chromium revision the installed playwright-core pins, so the
# skip-when-cached check below matches what `playwright-core install
# chromium` would actually download. Different playwright-core versions pin
# different revisions (the cache here holds chromium-1228, -1234, -1243
# side-by-side from prior runs), and `browsers.json` is the manifest
# playwright-core ships in-repo that names the revision this version wants.
PLAYWRIGHT_REV=$(node -p 'require("./node_modules/playwright-core/browsers.json").browsers.find(b => b.name === "chromium").revision')

# Skip the install entirely when both the pinned chromium AND its headless
# shell are already on disk. `INSTALLATION_COMPLETE` is the marker
# playwright-core writes once a browser is fully fetched + verified (it's the
# same marker its own registry checks on subsequent runs, so this is the
# canonical "is it there" signal — robust to layout changes like the move
# from chrome-linux/ to chrome-linux64/). Without this skip, re-running
# `bin/setup` would re-invoke the CLI, which would re-scan and exit clean but
# still pay the startup cost; with it, the second run is a directory stat.
if [ -f "$CACHE_DIR/chromium-$PLAYWRIGHT_REV/INSTALLATION_COMPLETE" ] \
   && [ -f "$CACHE_DIR/chromium_headless_shell-$PLAYWRIGHT_REV/INSTALLATION_COMPLETE" ]; then
  echo "==> chromium $PLAYWRIGHT_REV + headless_shell already at $CACHE_DIR, skipping install"
else
  echo "==> chromium install (playwright-core revision $PLAYWRIGHT_REV)"
  # Use the repo-pinned CLI, NEVER `bunx playwright`: `bunx` resolves an
  # unpinned version that "exit 0 in 0.7s without fetching the headless
  # shell the pinned version requires" (the "install chromium" step comment
  # in .github/workflows/ci.yml). This stage DOWNLOADS only — it never
  # installs system libraries. The library check in the next stage is what
  # inspects the binary's shared libraries, and it remediates missing ones
  # via apt / install-deps.
  # Bounded retry: `timeout` kills a wedged or crawling attempt so the retry
  # actually fires. Exit 124 (or 137 after the KILL fallback) means the
  # 300s budget was exceeded and the attempt is logged as such. 300s
  # dwarfs the ~19s a healthy install took while leaving 3 attempts +
  # backoff inside any reasonable outer budget.
  install_ok=0
  for attempt in 1 2 3; do
    # `|| rc=$?` is the form `set -e` exempts (same family as the `${CI:+...}`
    # idiom above): a failed attempt must fall through to the rc checks below
    # so the retry + backoff actually run. A bare `timeout …` line here would
    # abort the whole script on the FIRST non-zero exit and the 3-attempt loop
    # would be dead code — the exact defect CodeRabbit's pre-merge check
    # flagged on PR #84.
    rc=0
    timeout --kill-after=30 300 node node_modules/playwright-core/cli.js install chromium || rc=$?
    if [ "$rc" -eq 0 ]; then
      echo "chromium installed (attempt $attempt/3)"
      install_ok=1
      break
    fi
    if [ "$rc" -eq 124 ] || [ "$rc" -eq 137 ]; then
      echo "::warning::attempt $attempt/3 exceeded its 300s budget and was killed (exit $rc)"
    else
      echo "::warning::chromium install attempt $attempt/3 failed (exit $rc)"
    fi
    if [ "$attempt" -lt 3 ]; then
      sleep $((attempt * 20))
    fi
  done
  if [ "$install_ok" -ne 1 ]; then
    echo "::error::chromium install failed after 3 attempts — see output above" >&2
    exit 1
  fi
fi

# Library gate: prove every shared library pinned full Chromium and its headless
# shell need actually resolves, BEFORE the launch check — a missing lib then fails
# HERE with the error naming it (and the fix), not as a mystery inside the
# launch. `src/cli/chromium-libs.ts` exits 0 when everything resolves, and
# exits 1 with an `X_CHROMIUM_LIBS_MISSING:` diagnostic on stderr naming every
# missing library plus the remediation command. It installs the missing
# libraries itself ONLY when they are missing AND noninteractive elevation is
# available (`sudo -n`), so no path here can hang on a password prompt.
# `set -e` aborts the script on its non-zero exit — the launch check below
# must not run against a browser that cannot start.
echo "==> verify chromium shared libraries"
bun src/cli/chromium-libs.ts "$CACHE_DIR"

# Runtime gate: launch the default headless shell, then explicitly launch full
# Chromium (the adapter uses chromium.executablePath()), closing each in turn.
# The library check above covers both binaries. If anything is missing, this fails
# HERE with the error naming it (e.g. "Chromium distribution 'X' is not found
# at Y" — same shape as the issue's #83 baseline-red), not as a mystery inside
# `bin check` / `bun test`. Not retried: a missing binary or library is
# not transient.
echo "==> verify chromium launches"
bun -e '(async () => {
  const { chromium } = await import("playwright-core");
  const browser = await chromium.launch({ headless: true });
  console.log("chromium headless shell " + browser.version() + " launched");
  await browser.close();
  const fullBrowser = await chromium.launch({ headless: true, executablePath: chromium.executablePath() });
  console.log("full chromium " + fullBrowser.version() + " launched headless");
  await fullBrowser.close();
})().catch((err) => { console.error(err); process.exit(1); })'

echo "==> ready. try: bin/check"
