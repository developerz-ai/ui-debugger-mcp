{
  "models": {
    "driver": "deepseek/deepseek-v4-flash",
    "vision": "qwen/qwen3-vl-32b-instruct",
    "summary": "deepseek/deepseek-v4-flash"
  },
  "workspace": "./tmp/ui-debugger-mcp",
  "targets": {
    "web": {
      "adapter": "browser",
      "url": "http://localhost:3000",
      "headless": true,
      "notes": "needs seeded data — empty tables are expected on /new\nfirst load shows an onboarding modal; dismiss it\ndark mode is the default theme",
      "debugLogin": { "param": "debug-ai" },
      "auth": {
        "admin": {
          "path": "/login",
          "fields": { "email": "admin@dev.local", "password": "admin" },
          "submit": "Sign in"
        },
        "user": {
          "path": "/login",
          "fields": { "email": "user@dev.local", "password": "user" },
          "submit": "Sign in",
          "expect": "text=Sign out"
        }
      },
      "executablePath": null,
      "profile": "chrome-user-data",
      "cdpUrl": null
    },
    "desktop": {
      "adapter": "desktop",
      "launch": "my-desktop-app",
      "window": { "title": "My Desktop App" },
      "display": null
    },
    "mobile": {
      "adapter": "android",
      "avd": "my-avd",
      "emulatorPath": null,
      "adbSerial": null
    },
    "phone": {
      "adapter": "android",
      "adbSerial": "R58M12ABCDE"
    }
  }
}
